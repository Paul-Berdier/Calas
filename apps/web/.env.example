CONTENT_MODE=database
SITE_ENV=development
SITE_URL=http://localhost:4321
HOST=127.0.0.1
PORT=4321
# pnpm local:prepare génère les valeurs locales privées ci-dessous.
DATABASE_URL=
DATABASE_POOL_MAX=10
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=calas-development
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Laisser false sauf origine exclusivement accessible via le proxy Railway vérifié.
TRUST_RAILWAY_PROXY=false
# Boîte de recette locale, sans distribution externe.
AUTH_MAIL_TRANSPORT=local
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=11025
AUTH_SMTP_FROM=Calas Conseil <cms@example.test>
MAIL_TRANSPORT=simulation
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=recette@example.test
# SMTP réel nécessite une autorisation explicite.
ALLOW_REAL_EMAIL=false
CONTACT_RATE_LIMIT=5
CONTACT_SIGNING_SECRET=
# Garder cette clé séparée des archives en exploitation.
BACKUP_ENCRYPTION_KEY=
BACKUP_POSTGRES_CONTAINER=calas-development-postgres-1
