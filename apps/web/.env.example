CONTENT_MODE=demo
SITE_ENV=development
SITE_URL=http://localhost:4321
HOST=127.0.0.1
PORT=4321
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=staging
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
SANITY_API_READ_TOKEN=
# Jeton Editor temporaire pour le seul import des brouillons initiaux. Jamais PUBLIC_.
SANITY_WRITE_TOKEN=
# Activer uniquement pour un import voulu dans le dataset de test.
CALAS_ALLOW_CONTENT_WRITE=no
PREVIEW_SESSION_SECRET=
# simulation = validation + transport mémoire, aucun courriel envoyé ou conservé.
MAIL_TRANSPORT=simulation
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=recette@example.test
# N'activer qu'après autorisation explicite d'envoi réel hors production.
ALLOW_REAL_EMAIL=false
CONTACT_RATE_LIMIT=5
# Généré au démarrage en local si absent ; obligatoire en production (32 caractères min.).
CONTACT_SIGNING_SECRET=
