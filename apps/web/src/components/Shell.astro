---
import {ribbonPaths,gradientStops,viewBox} from '../../../../assets/brand/geometry.mjs';
interface Props {
 animated?: boolean;
 class?: string;
 idPrefix?: string;
 monochrome?: string;
}
const {animated=false,class:className='',idPrefix=`shell-${crypto.randomUUID()}`,monochrome}=Astro.props;
const gradientId=`${idPrefix}-gold`;
---
{animated&&<script is:inline>
 // Activate the CSS guard before the SVG can enter a streamed first paint.
 // Without scripting this class is absent and the complete mark stays visible.
 if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  document.documentElement.classList.add('calas-motion-enabled');
 }
</script>}
<svg class:list={['calas-shell',className]} viewBox={viewBox} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" data-shell-animate={animated ? '' : undefined}>
 { !monochrome && <defs><linearGradient id={gradientId} x1="0" y1="0.65" x2="1" y2="0.25" gradientUnits="objectBoundingBox">
  {gradientStops.map(([offset,color])=><stop offset={offset} stop-color={color}/>)}
 </linearGradient></defs>}
 {ribbonPaths.map((d,index)=><path d={d} fill={monochrome??`url(#${gradientId})`} data-ribbon={index}/>)}
</svg>
{animated&&<script is:inline>
 // Runs directly after this SVG, before its first paint. The server-rendered
 // fallback stays complete when scripting or the motion module is unavailable.
 {
  const shell=document.currentScript?.previousElementSibling;
  if(shell instanceof SVGElement&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
   shell.setAttribute('data-shell-pending','');
   shell.style.visibility='hidden';
   window.setTimeout(()=>{
    if(shell.hasAttribute('data-shell-pending')){
     shell.removeAttribute('data-shell-pending');
     shell.setAttribute('data-shell-fallback','');
     shell.style.removeProperty('visibility');
    }
   },1400);
  }
 }
</script>}
<style>
 .calas-shell{display:block;width:100%;height:auto;overflow:visible}
 @media(prefers-reduced-motion:no-preference){
  :global(html.calas-motion-enabled) .calas-shell[data-shell-animate]:not([data-motion-ready="true"]):not([data-shell-fallback]){visibility:hidden}
 }
</style>
