---
import type { ContentFile } from '../lib/cms/types';
import { pdfDownload } from '../lib/cms/files';
interface Props { file?: ContentFile }
const pdf = pdfDownload(Astro.props.file);
---
{pdf && <a class="article-pdf" href={pdf.url} download={pdf.filename} type="application/pdf" rel="noreferrer">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg>
  <span>Télécharger le PDF original<small>PDF{pdf.size && ` · ${pdf.size}`}</small></span>
</a>}
<style>
  .article-pdf{display:flex;align-items:center;gap:16px;width:fit-content;max-width:100%;margin-top:28px;padding:17px 22px;border:1px solid var(--gold);background:var(--paper,#f7f2ea);color:var(--navy,#14213a);font:500 15px/1.4 var(--ui,Arial,sans-serif);text-decoration:none}
  .article-pdf svg{width:25px;height:25px;flex-shrink:0}
  .article-pdf span{min-width:0}
  .article-pdf small{display:block;margin-top:4px;font-size:11px;font-weight:400;letter-spacing:.06em}
  .article-pdf:hover{background:var(--navy,#14213a);color:var(--cream,#fffdf8);border-color:var(--navy,#14213a)}
  .article-pdf:focus-visible{outline:3px solid var(--ink-accent,#74552f);outline-offset:5px}
  @media(max-width:430px){.article-pdf{font-size:14px;padding:15px 16px;gap:12px}}
</style>
