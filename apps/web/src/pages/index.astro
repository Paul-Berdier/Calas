---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import CTA from '../components/CTA.astro';
import CmsImage from '../components/CmsImage.astro';
import EditorialSymbol from '../components/EditorialSymbol.astro';
import Registration from '../components/Registration.astro';
import '../styles/home.css';
import {safeHref} from '../lib/links';
import {getSiteContent} from '../lib/cms/client';
import {homeCaptions} from '../lib/cms/home-captions';
import type {Home} from '../lib/cms/types';
const {home,settings,pages,people}=await getSiteContent(Astro);
const editorial=home.editorial??{};
const captions={...homeCaptions,...editorial};
const visuals=home.visuals??{};
const offers=['diagnostic-rps','equipes','managers'].flatMap(slug=>pages.filter(p=>p.slug===slug));
const cards:NonNullable<Home['journey']>['cards']=home.journey?.cards??offers.map((offer,index)=>({key:offer.id,eyebrow:['Le socle','L’action au quotidien','L’ancrage dans la durée'][index],title:offer.title,text:offer.offerExcerpt??offer.intro,cta:{label:'Découvrir',href:`/${offer.slug}/`}}));
const symbols=['roots','compass','tree'] as const;
const statistics=home.statistics.filter(s=>s.verified);
const groups=[
  {title:'Ce que vivent les équipes',items:statistics.filter(s=>s.group==='people'||!s.group)},
  {title:'Ce que ça coûte',items:statistics.filter(s=>s.group==='financial')},
  {title:'Les conséquences pour les organisations',items:statistics.filter(s=>s.group==='cost')},
];
const paragraphs=(text:string)=>text.split(/\n\s*\n/).filter(p=>p.trim());
const convictionParagraphs=paragraphs(home.conviction.text);
const convictionLead=home.conviction.title==='Notre conviction'?convictionParagraphs.shift():home.conviction.title;
const convictionTitle=convictionLead?.match(/^(.*?:)\s*(.+)$/);
const [caption,...captionLines]=(editorial.heroArtCaption??'Cabinet de conseil\nen stratégie RH.').split(/\r?\n/);
function linkSources(text:string) {
  const fragments:Array<{text:string; href?:string}>=[];
  const sources=(home.whyNow?.sources??[]).filter(source=>source.label && text.includes(source.label))
    .map(source=>({...source, index:text.indexOf(source.label)})).sort((a,b)=>a.index-b.index);
  let start=0;
  for(const source of sources){
    if(source.index<start) continue;
    fragments.push({text:text.slice(start,source.index)},{text:source.label,href:source.href});
    start=source.index+source.label.length;
  }
  fragments.push({text:text.slice(start)});
  return fragments;
}
const titleMatch=home.title.match(/^(.*?)\s+(par la qualité du lien)$/i);
---
<Layout settings={settings} title={home.seo?.title || 'Calas Conseil — La performance durable par la qualité du lien'} description={home.seo?.description}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">{titleMatch?<>{titleMatch[1]}<em>{titleMatch[2]}</em></>:home.title}</h1>
        <div class="hero-intro">{paragraphs(home.intro).map(p=><p>{p}</p>)}</div>
        <div class="actions"><CTA cta={home.primaryCta}/><CTA cta={home.secondaryCta} variant="link"/></div>
      </div>
      <div class="hero-art">
        <div class="hero-shell" aria-hidden="true"><Shell animated idPrefix="hero"/></div>
        <p class="hero-identity">{caption}{captionLines.map(line=><em>{line}</em>)}</p>
        <p class="hero-specialty"><span>{editorial.heroArtTop}</span><span>{editorial.heroArtBottom}</span></p>
      </div>
    </div>
    <div class="wrap hero-bottom"><p>{editorial.heroAudience??'Aux côtés des dirigeants, des managers et des équipes.'}</p><a href="#chemin" class="hero-scroll"><span>{editorial.exploreLabel||homeCaptions.exploreLabel}</span><span class="scroll-circle" aria-hidden="true">↓</span></a></div>
  </section>

  <section class="section home-journey" id="chemin" aria-labelledby="journey-title"><div class="wrap"><div class="journey-heading"><p class="eyebrow">01 / {editorial.domainsEyebrow??'Du diagnostic à la transformation'}</p><h2 id="journey-title" data-reveal>{home.domainsTitle??'Notre chemin en trois temps'}</h2></div><div class="journey-cards" data-reveal="group">{cards.map((card,i)=><a class="journey-card" href={safeHref(card.cta.href)}><div class="journey-symbol"><EditorialSymbol name={symbols[i%3]} image={visuals[symbols[i%3]]}/></div><p class="eyebrow">{card.eyebrow}</p><h3>{card.title}</h3><div class="journey-copy">{card.lead&&<p class="journey-lead"><strong><em>{card.lead}</em></strong></p>}<p>{card.text}</p></div><span class="journey-link">{card.cta.label}<span aria-hidden="true">↗</span></span></a>)}</div><p class="journey-transition">{home.journey?.transition??home.domainsIntro}</p>{home.journey&&<a class="sensitive-link" href={safeHref(home.journey.sensitiveCta.href)}><EditorialSymbol name="kintsugi" image={visuals.kintsugi}/><div><h3>{home.journey.sensitiveCta.label} <span aria-hidden="true">↗</span></h3><p>{home.journey.sensitiveText}</p></div></a>}</div></section>

  {home.whyNow&&<section class="section home-now" id="pourquoi-maintenant" aria-labelledby="now-title">
    <div class="wrap now-grid">
      <div class="now-illustration" data-reveal="fade">
        <EditorialSymbol name="nautilus" image={visuals.nautilus}/>
        {captions.whyNowImageCaption&&<span class="symbol-caption">{captions.whyNowImageCaption}</span>}
      </div>
      <div>
        {captions.whyNowEyebrow&&<p class="eyebrow">02 / {captions.whyNowEyebrow}</p>}
        <h2 id="now-title" data-reveal>{home.whyNow.title}</h2>
        <div class="now-copy">{paragraphs(home.whyNow.text).map(p=><p>{linkSources(p).map(part=>part.href?<a href={safeHref(part.href)}>{part.text}</a>:part.text)}</p>)}</div>
      </div>
    </div>
  </section>}

  <section class="section home-conviction" aria-labelledby="conviction-title">
    <div class="wrap stance-grid">
      <div>
        <p class="eyebrow">03 / {editorial.convictionEyebrow??'Ce qui nous distingue'}</p>
        <h2 id="conviction-title" data-reveal>{convictionTitle?<>{convictionTitle[1]}<em>{convictionTitle[2]}</em></>:convictionLead}</h2>
        <div class="conviction-copy">
          {convictionParagraphs.map(p=><p>{p}</p>)}
          {home.conviction.closingQuote&&<p class="conviction-quote"><em>{home.conviction.closingQuote}</em></p>}
          <CTA cta={home.conviction.cta} variant="link"/>
        </div>
      </div>
      <figure class="stance-figure" data-reveal="fade">
        <EditorialSymbol name="murmuration" image={visuals.murmuration}/>
        {captions.convictionImageCaption&&<figcaption class="symbol-caption">{captions.convictionImageCaption}</figcaption>}
      </figure>
      {visuals.calmFace&&<div class="conviction-calm"><CmsImage image={visuals.calmFace} width={880} height={1100} sizes="(max-width: 489px) 90vw, 440px"/></div>}
    </div>
  </section>

  <section class="section home-reasons dark" aria-labelledby="reasons-title">
    <div class="wrap">
      <p class="eyebrow">04 / {editorial.reasonsEyebrow??'Nos expertises'}</p>
      <div class="reasons-grid">
        <div class="reasons-heading">
          <h2 id="reasons-title" data-reveal>{home.reasonsTitle}</h2>
          <div class="home-people">
            {people.map(person =>
              <article>
                {person.portrait && <CmsImage class="home-portrait" image={person.portrait} width={480} height={600} sizes="(max-width:599px) 42vw, 192px"/>}
                <h3>{person.name}</h3>
                <p>{person.role}</p>
                <Registration settings={settings} person={person} profile/>
              </article>
            )}
          </div>
        </div>
        <div class="reasons">
          {home.reasons.map(reason=><article class="reason" data-reveal>{reason.title&&<h3>{reason.title}</h3>}<p>{reason.text}</p></article>)}
          <CTA cta={editorial.reasonsLink??{label:'Rencontrer Sara et Agnès',href:'/qui-sommes-nous/'}} variant="link"/>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-stats" id="chiffres" aria-labelledby="stats-title"><div class="wrap"><div class="section-heading"><p class="eyebrow">05 / {editorial.statisticsEyebrow??'Le travail en chiffres'}</p><div><h2 id="stats-title" data-reveal>{home.statisticsTitle??'Quelques repères'}</h2>{editorial.statisticsDescription&&<p class="section-description">{editorial.statisticsDescription}</p>}</div></div>{groups.filter(group=>group.items.length).map(group=><div class="statistics-group"><h3>{group.title}</h3><div class="stats" data-reveal="group">{group.items.map(stat=><article class="stat"><p class="stat-value">{stat.value}</p><p class="stat-label">{stat.label}</p><div class="stat-source"><a href={safeHref(stat.sourceUrl)} target="_blank" rel="noopener noreferrer">{stat.source} <span aria-hidden="true">↗</span><span class="sr-only"> (nouvel onglet)</span></a><p>{stat.note}</p><span>Publication : {stat.year}</span></div></article>)}</div></div>)}<p class="stats-note">{editorial.statisticsNote}</p><div class="stats-transition"><span aria-hidden="true">↳</span><p>{home.statisticsTransition}</p></div></div></section>

  <section class="home-closing" aria-labelledby="closing-title"><div class="wrap">{visuals.closing&&<CmsImage class="closing-image" image={visuals.closing} width={1280} height={640} sizes="90vw"/>}{captions.closingEyebrow&&<p class="eyebrow">{captions.closingEyebrow}</p>}<h2 id="closing-title" data-reveal>{home.closingTitle??'Parlons de vos priorités.'}</h2>{home.closingCta&&<CTA cta={home.closingCta}/>}</div></section>
</Layout>
