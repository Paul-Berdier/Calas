---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import CTA from '../components/CTA.astro';
import CmsImage from '../components/CmsImage.astro';
import EditorialSymbol from '../components/EditorialSymbol.astro';
import Registration from '../components/Registration.astro';
import '../styles/home.css';
import {safeHref} from '../lib/links';
import {getSiteContent} from '../lib/cms/client';
import type {Home} from '../lib/cms/types';
const {home,settings,pages,people}=await getSiteContent(Astro);
const editorial=home.editorial??{};
const visuals=home.visuals??{};
const offers=['diagnostic-rps','equipes','managers'].flatMap(slug=>pages.filter(p=>p.slug===slug));
const cards:NonNullable<Home['journey']>['cards']=home.journey?.cards??offers.map((offer,index)=>({key:offer.id,eyebrow:['Le socle','L’action au quotidien','L’ancrage dans la durée'][index],title:offer.title,text:offer.offerExcerpt??offer.intro,cta:{label:'Découvrir',href:`/${offer.slug}/`}}));
const symbols=['roots','compass','tree'] as const;
const statistics=home.statistics.filter(s=>s.verified);
const groups=[{title:'Ce que vivent les équipes',items:statistics.filter(s=>s.group==='people'||!s.group)},{title:'Les conséquences pour les organisations',items:statistics.filter(s=>s.group==='cost')}];
const paragraphs=(text:string)=>text.split(/\n\s*\n/).filter(p=>p.trim());
const convictionParagraphs=paragraphs(home.conviction.text);
const convictionLead=home.conviction.title==='Notre conviction'?convictionParagraphs.shift():home.conviction.title;
const titleMatch=home.title.match(/^(.*?)\s+(par la qualité du lien)$/i);
---
<Layout settings={settings} title={home.seo?.title || 'Calas Conseil — La performance durable par la qualité du lien'} description={home.seo?.description}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{home.eyebrow}</p>
        <h1 id="hero-title">{titleMatch?<>{titleMatch[1]}<em>{titleMatch[2]}</em></>:home.title}</h1>
        <div class="hero-intro">{paragraphs(home.intro).map(p=><p>{p}</p>)}</div>
        <div class="actions"><CTA cta={home.primaryCta}/><CTA cta={home.secondaryCta} variant="link"/></div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="hero-shell"><Shell animated idPrefix="hero"/></div><p>La voie de la<br/><em>qualité relationnelle.</em></p></div>
    </div>
    <div class="hero-weaving" aria-hidden="true"><EditorialSymbol name="threads" image={visuals.threads} eager/></div>
    <div class="wrap hero-bottom"><p>{editorial.heroAudience??'Aux côtés des dirigeants, des managers et des équipes.'}</p><a href="#pourquoi-maintenant" class="hero-scroll" aria-label="Explorer notre démarche"><span>Explorer notre démarche</span><span class="scroll-circle" aria-hidden="true">↓</span></a></div>
  </section>

  {home.whyNow&&<section class="section home-now" id="pourquoi-maintenant" aria-labelledby="now-title"><div class="wrap now-grid"><div class="now-illustration" data-reveal="fade"><EditorialSymbol name="nautilus" image={visuals.nautilus}/><span class="symbol-caption">Grandir, en restant soi-même.</span></div><div><p class="eyebrow">01 / Comprendre notre époque</p><h2 id="now-title" data-reveal>{home.whyNow.title}</h2><div class="now-copy">{paragraphs(home.whyNow.text).map(p=><p>{p}</p>)}</div></div></div></section>}

  <section class="section home-journey" id="chemin" aria-labelledby="journey-title"><div class="wrap"><div class="journey-heading"><p class="eyebrow">02 / Du diagnostic à la transformation</p><h2 id="journey-title" data-reveal>{home.domainsTitle??'Notre chemin en trois temps'}</h2></div><div class="journey-cards" data-reveal="group">{cards.map((card,i)=><a class="journey-card" href={safeHref(card.cta.href)}><div class="journey-symbol"><EditorialSymbol name={symbols[i%3]} image={visuals[symbols[i%3]]}/><span class="journey-index" aria-hidden="true">0{i+1}</span></div><p class="eyebrow">{card.eyebrow}</p><h3>{card.title}</h3><div class="journey-copy">{card.lead&&<p class="journey-lead"><strong><em>{card.lead}</em></strong></p>}<p>{card.text}</p></div><span class="journey-link">{card.cta.label}<span aria-hidden="true">↗</span></span></a>)}</div><p class="journey-transition">{home.journey?.transition??home.domainsIntro}</p>{home.journey&&<a class="sensitive-link" href={safeHref(home.journey.sensitiveCta.href)}><EditorialSymbol name="kintsugi" image={visuals.kintsugi}/><div><p>{home.journey.sensitiveText}</p><span>{home.journey.sensitiveCta.label} <span aria-hidden="true">↗</span></span></div></a>}</div></section>

  <section class="section home-conviction" aria-labelledby="conviction-title"><div class="wrap"><p class="eyebrow">03 / Notre conviction</p><div class="conviction-lead"><h2 id="conviction-title" data-reveal>{convictionLead}</h2><EditorialSymbol name="ripples" image={visuals.ripples}/></div><div class="conviction-body"><div class="conviction-birds" data-reveal="fade"><EditorialSymbol name="murmuration" image={visuals.murmuration}/><p class="symbol-caption">Un collectif vivant, autonome et relié.</p></div><div class="conviction-copy">{convictionParagraphs.map(p=><p>{p}</p>)}{home.conviction.closingQuote&&<p class="conviction-quote"><em>{home.conviction.closingQuote}</em></p>}<CTA cta={home.conviction.cta} variant="link"/></div></div>{visuals.calmFace&&<div class="conviction-calm" data-reveal="fade"><CmsImage image={visuals.calmFace} width={880} height={1100} sizes="(max-width: 489px) 90vw, 440px"/></div>}</div></section>

  <section class="section home-reasons dark" aria-labelledby="reasons-title"><div class="wrap"><p class="eyebrow">04 / Pourquoi choisir Calas Conseil</p><div class="reasons-grid"><div class="reasons-heading"><h2 id="reasons-title" data-reveal>{home.reasonsTitle}</h2><div class="home-people">{people.map(person=><article>{person.portrait&&<CmsImage image={person.portrait} width={500} height={625} sizes="(max-width:599px) 42vw, 20vw"/>}<h3>{person.name}</h3><p>{person.role}</p></article>)}</div><Registration settings={settings} person={people.find(person=>person.id===settings.qualification.personId)}/></div><div class="reasons">{home.reasons.map(reason=><article class="reason" data-reveal>{reason.title&&<h3>{reason.title}</h3>}<p>{reason.text}</p></article>)}<CTA cta={editorial.reasonsLink??{label:'Rencontrer Sara et Agnès',href:'/qui-sommes-nous/'}} variant="link"/></div></div></div></section>

  <section class="section home-stats" id="chiffres" aria-labelledby="stats-title"><div class="wrap"><div class="section-heading"><p class="eyebrow">05 / Quelques repères</p><div><h2 id="stats-title" data-reveal>{home.statisticsTitle??'Quelques repères'}</h2>{editorial.statisticsDescription&&<p class="section-description">{editorial.statisticsDescription}</p>}</div></div>{groups.filter(group=>group.items.length).map(group=><div class="statistics-group"><h3>{group.title}</h3><div class="stats" data-reveal="group">{group.items.map(stat=><article class="stat"><p class="stat-value">{stat.value}</p><p class="stat-label">{stat.label}</p><div class="stat-source"><a href={safeHref(stat.sourceUrl)} target="_blank" rel="noopener noreferrer">{stat.source} <span aria-hidden="true">↗</span><span class="sr-only"> (nouvel onglet)</span></a><p>{stat.note}</p><span>Publication : {stat.year}</span></div></article>)}</div></div>)}<p class="stats-note">{editorial.statisticsNote}</p><div class="stats-transition"><span aria-hidden="true">↳</span><p>{home.statisticsTransition}</p></div></div></section>

  <section class="home-closing" aria-labelledby="closing-title"><div class="wrap">{visuals.closing&&<CmsImage class="closing-image" image={visuals.closing} width={1280} height={640} sizes="90vw"/>}<p class="eyebrow">Le premier pas se fait ensemble</p><h2 id="closing-title" data-reveal>{home.closingTitle??'Parlons de vos priorités.'}</h2>{home.closingCta&&<CTA cta={home.closingCta}/>}</div></section>
</Layout>
