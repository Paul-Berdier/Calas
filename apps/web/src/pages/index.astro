---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import LinkArt from '../components/LinkArt.astro';
import CTA from '../components/CTA.astro';
import CmsImage from '../components/CmsImage.astro';
import EditorialLines from '../components/EditorialLines.astro';
import '../styles/home.css';
import {safeHref} from '../lib/links';
import {getSiteContent} from '../lib/cms/client';
const {home,settings,pages}=await getSiteContent(Astro);
const titleParts=home.title.split(' : ');
const offers=['diagnostic-rps','equipes','managers'].flatMap(slug=>pages.filter(p=>p.slug===slug));
const diagnostic=offers.find(page=>page.slug==='diagnostic-rps');
const method=diagnostic?.sections.find(section=>section.presentation==='method')??diagnostic?.sections.find(section=>section.kind==='steps');
const editorial=home.editorial??{};
const reasonsLink=editorial.reasonsLink??{label:'Rencontrer Sara & Agnès',href:'/qui-sommes-nous/'};
const exploreLabel=editorial.exploreLabel??'Explorer notre démarche';
---
<Layout settings={settings} title={home.seo?.title || 'Calas Conseil — Diagnostic RPS et qualité du lien'} description={home.seo?.description}>
  <section class="home-hero dark" aria-labelledby="hero-title">
    <div class="hero-grain" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="hero-dot" aria-hidden="true"></span>{home.eyebrow}</p>
          <h1 id="hero-title">{titleParts.length===2?<>{titleParts[0]}&#160;:<em>{titleParts[1]}</em></>:home.title}</h1>
          <p class="hero-intro">{home.intro}</p>
          <div class="actions"><CTA cta={home.primaryCta} variant="light" /><CTA cta={home.secondaryCta} variant="link" /></div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="hero-art-halo"></div>
          <svg class="hero-orbits" viewBox="0 0 640 680" fill="none"><ellipse cx="320" cy="326" rx="280" ry="302" stroke="currentColor" stroke-opacity=".2"/><ellipse cx="320" cy="326" rx="238" ry="258" stroke="currentColor" stroke-opacity=".13"/><path data-line d="M46 340C48 160 198 30 367 33M584 302C593 463 475 610 310 628" stroke="currentColor"/><path d="M320 0V46M320 614V680M0 326H62M578 326H640" stroke="currentColor" stroke-opacity=".45"/><circle cx="47" cy="340" r="4" fill="currentColor"/><circle cx="584" cy="302" r="4" fill="currentColor"/></svg>
          <div class="hero-shell"><Shell animated idPrefix="hero" /></div>
          <span class="art-label art-label-top">{editorial.heroArtTop??'De la compréhension'}</span><span class="art-label art-label-bottom">{editorial.heroArtBottom??'à la transformation'}</span>
          <span class="hero-art-caption"><EditorialLines text={editorial.heroArtCaption??'La voie de la\nqualité relationnelle.'} accentLast/></span>
        </div>
      </div>
      <div class="hero-bottom"><p><EditorialLines text={editorial.heroAudience??'Aux côtés des dirigeants de PME & ETI,\ndes RH et des CSE.'}/></p><span class="hero-disciplines">{(editorial.heroDisciplines??['Organisation','Management','Relations']).map((label,index)=><Fragment>{index>0&&<span>·</span>}{label}</Fragment>)}</span><a href="#chiffres" class="hero-scroll" aria-label={exploreLabel}><span>{exploreLabel}</span><span class="scroll-circle" aria-hidden="true">↓</span></a></div>
    </div>
  </section>

  <section class="section home-stats" id="chiffres" aria-labelledby="stats-title">
    <div class="wrap">
      <div class="section-heading"><p class="eyebrow"><span class="section-number">01 /</span> {editorial.statisticsEyebrow??'Prendre la mesure'}</p><div data-reveal><h2 id="stats-title">{home.statisticsTitle}</h2><p class="section-description"><EditorialLines text={editorial.statisticsDescription??'Derrière les indicateurs, des situations de travail.\nEt des liens qui ont besoin d’attention.'}/></p></div></div>
      <div class="stats" data-reveal="group">{home.statistics.filter(s=>s.verified).map(s=><article class="stat"><p class="stat-value">{s.value}</p><p class="stat-label">{s.label}</p><div class="stat-source"><a href={safeHref(s.sourceUrl)} target="_blank" rel="noopener noreferrer">{s.source}<span class="sr-only"> (nouvel onglet)</span> ↗</a><p>{s.note}</p><span>Publication : {s.year}</span></div></article>)}</div>
      <p class="stats-note">{editorial.statisticsNote??'Ces données décrivent des réalités distinctes et ne mesurent pas la même chose.'}</p>
      <div class="stats-transition" data-reveal><span aria-hidden="true">↳</span><p>{home.statisticsTransition}</p></div>
    </div>
  </section>

  <section class="home-diagnostic" id="diagnostic" aria-labelledby="diagnostic-title">
    <div class="wrap diagnostic-grid">
      <div class="diagnostic-visual dark"><p class="eyebrow">{editorial.diagnosticArtEyebrow??'Comprendre ce qui se joue'}</p>{home.diagnostic.image?<CmsImage image={home.diagnostic.image} width={800} height={800} sizes="(max-width: 760px) 100vw, 40vw"/>:<LinkArt variant="converge" tone="dark"/>}<div class="visual-legend">{(editorial.diagnosticArtLegend??['Organisation','Relations','Personnes']).map(label=><span>{label}</span>)}</div><p class="visual-signature"><EditorialLines text={editorial.diagnosticArtTitle??'Relier les signaux.\nFaire émerger le sens.'} accentLast/></p></div>
      <div class="diagnostic-copy"><p class="eyebrow"><span class="section-number">02 /</span> {editorial.diagnosticEyebrow??'Diagnostic & prévention des RPS'}</p><h2 id="diagnostic-title" data-reveal>{home.diagnostic.title}</h2><p class="lead">{home.diagnostic.text}</p><ol class="home-method" aria-label="Les étapes du diagnostic">{method?.items?.map((step,i)=><li data-reveal><span>{step.number??String(i+1).padStart(2,'0')}</span>{step.title}<span aria-hidden="true">↗</span></li>)}</ol><CTA cta={home.diagnostic.cta}/><p class="legal-note">{editorial.diagnosticNote??'L’évaluation des RPS fait partie des obligations de prévention de l’employeur. Nous vous aidons à structurer cette démarche.'}</p></div>
    </div>
  </section>

  <section class="section home-reasons dark" aria-labelledby="reasons-title">
    <div class="wrap reasons-grid">
      <div class="reasons-heading"><p class="eyebrow"><span class="section-number">03 /</span> {editorial.reasonsEyebrow??'Pourquoi Calas Conseil'}</p><h2 id="reasons-title" class="line-break" data-reveal>{home.reasonsTitle}</h2><div class="dual-mark" aria-hidden="true"><span></span><span></span><i>{editorial.reasonsMotifLabel??'Le lien'}</i></div><a class="text-link" href={safeHref(reasonsLink.href)}>{reasonsLink.label} <span class="arrow" aria-hidden="true">↗</span></a></div>
      <div class="reasons">{home.reasons.map((reason,i)=><article class="reason" data-reveal><span class="index">0{i+1}</span><div><h3>{reason.title}</h3><p>{reason.text}</p></div></article>)}</div>
    </div>
  </section>

  <section class="section home-offers" id="accompagnements" aria-labelledby="offers-title">
    <div class="wrap"><div class="section-heading"><p class="eyebrow"><span class="section-number">04 /</span> {editorial.domainsEyebrow??'Nos accompagnements'}</p><div data-reveal><h2 id="offers-title" class="line-break">{home.domainsTitle}</h2><p class="section-description">{home.domainsIntro}</p></div></div>
      <div class="offer-list">{offers.map((offer,i)=><a class="offer-row" href={`/${offer.slug}/`} data-reveal><span class="offer-index">0{i+1}</span><div class="offer-title"><p class="eyebrow">{offer.eyebrow}</p><h3>{offer.title}</h3></div><p class="offer-excerpt">{offer.offerExcerpt??offer.intro.split(/(?<=\.)\s/)[0]}</p><span class="offer-arrow" aria-hidden="true">↗</span><span class="sr-only">Découvrir l’accompagnement</span></a>)}</div>
    </div>
  </section>

  <section class="home-conviction" aria-labelledby="conviction-title">
    <div class="wrap"><div class="conviction-heading"><p class="eyebrow"><span class="section-number">05 /</span> {editorial.convictionEyebrow??'Notre conviction'}</p><Shell idPrefix="conviction" class="conviction-shell" /></div><div class="conviction-grid"><h2 id="conviction-title" data-reveal>{home.conviction.title}</h2><div class="conviction-copy" data-reveal><p>{home.conviction.text}</p><CTA cta={home.conviction.cta} variant="link" /></div></div><div class="home-closing"><h3 class="line-break">{home.closingTitle}</h3>{home.closingCta&&<CTA cta={home.closingCta}/>}</div></div>
  </section>
</Layout>
