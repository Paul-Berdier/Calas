---
import Layout from '../../layouts/Layout.astro';

import RichText from '../../components/RichText.astro';
import CmsImage from '../../components/CmsImage.astro';
import ArticlePdf from '../../components/ArticlePdf.astro';
import {getSiteContent} from '../../lib/cms/client';
import {isLinkedInArticleUrl} from '../../lib/article-links';
import {env,isProductionSite} from '../../lib/environment';
import '../../styles/contact-editorial.css';
const {settings,articles}=await getSiteContent(Astro);
const article=articles.find(a=>a.slug===Astro.params.slug);
if(!article)return Astro.rewrite('/404/');
const externalUrl=isLinkedInArticleUrl(article.externalUrl)?article.externalUrl:undefined;
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.excerpt,datePublished:article.date,...(article.author?{author:{'@type':'Person',name:article.author.name}}:{}),publisher:{'@type':'Organization',name:settings.brand},...(isProductionSite()?{mainEntityOfPage:new URL(`/reflexions/${article.slug}/`,env('SITE_URL')).href}:{})};
---
<Layout settings={settings} title={article.seo?.title||`${article.title} | Calas Conseil`} description={article.seo?.description||article.excerpt} noindex={Boolean(externalUrl)}>
  {!externalUrl&&<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g,'\\u003c')}/>}
  <article class="reading-page wrap">
    <header class="reading-header">
      <nav class="journal-breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/reflexions/">Réflexions</a><span aria-hidden="true">/</span><span>{article.category?.title||'Article'}</span></nav>
      <p class="journal-kicker"><span aria-hidden="true"></span>{article.category?.title||'Le carnet de Calas Conseil'}</p>
      <h1>{article.title}</h1>
      <p class="reading-deck">{article.excerpt}</p>
      <div class="reading-byline"><span>Par {article.author?.name||'Auteur à renseigner'}</span><time datetime={article.date}>{article.date?new Intl.DateTimeFormat('fr-FR',{dateStyle:'long'}).format(new Date(article.date)):'Date à renseigner'}</time></div>
      <ArticlePdf file={article.sourcePdf}/>
      {article.image&&<figure class="reading-cover"><CmsImage image={article.image} width={1440} height={900} sizes="(max-width: 760px) 90vw, 80vw" loading="eager"/></figure>}
    </header>
    <div class="reading-layout">
      <aside class="reading-sidebar" aria-label="À propos de l’auteure"><p class="journal-caption">Un regard de</p><p class="reading-author">{article.author?.name||'Auteur à renseigner'}</p><p class="reading-author-role">{article.author?.role||''}</p><a href="/qui-sommes-nous/" class="journal-text-link">Faire connaissance <span aria-hidden="true">↗</span></a></aside>
      <div class="reading-copy">{externalUrl?<><p>Retrouvez le texte complet de {article.author?.name||'l’auteure'} dans sa publication originale sur LinkedIn.</p><p><a class="journal-text-link" href={externalUrl} rel="external noopener noreferrer">Lire sur LinkedIn <span aria-hidden="true">↗</span></a></p></>:<RichText value={article.body}/>}</div>
    </div>
    <footer class="reading-footer"><a class="journal-text-link" href="/reflexions/"><span aria-hidden="true">←</span> Toutes les réflexions</a><a class="journal-text-link" href="/contact/">Échanger sur votre situation <span aria-hidden="true">↗</span></a></footer>
  </article>
</Layout>
