{
  "name": "@calas/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/cms-preview-build.mjs && astro dev --host 127.0.0.1",
    "build": "node ../../scripts/cms-preview-build.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@sanity/astro": "3.6.0",
    "@sanity/client": "8.11.0",
    "@sanity/image-url": "2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/visual-editing": "6.2.0",
    "@portabletext/astro": "0.2.0",
    "groq": "6.20.0",
    "gsap": "3.15.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@portabletext/types": "4.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
