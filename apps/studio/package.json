{
  "name": "@calas/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/cms-pdf-assets.mjs && sanity dev --host 127.0.0.1",
    "build": "node ../../scripts/cms-pdf-assets.mjs && sanity build",
    "typecheck": "tsc --noEmit",
    "schema:extract": "sanity schema extract --path schema.json --force",
    "typegen": "sanity typegen generate",
    "deploy": "node ../../scripts/cms-pdf-assets.mjs && sanity deploy"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
