{
  "name": "calas-conseil",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @calas/web dev",
    "build": "pnpm --filter @calas/web build",
    "preview": "pnpm --filter @calas/web preview",
    "start": "pnpm --filter @calas/web start",
    "typecheck": "pnpm --filter @calas/web typecheck && pnpm --filter @calas/mcp typecheck",
    "build:mcp": "pnpm --filter @calas/mcp build",
    "test:mcp": "pnpm build:mcp && pnpm --filter @calas/web exec tsx --test --test-concurrency=1 ../../tests/agent-access.test.ts ../../tests/agent-mcp.test.ts ../../tests/agent-oauth.test.ts",
    "lint": "eslint apps/web/src apps/mcp/src --no-warn-ignored",
    "test": "playwright test",
    "test:unit": "playwright test tests/cms.spec.ts tests/contact-unit.spec.ts --project=chromium",
    "test:cms-local": "node scripts/run-local-tests.mjs",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:dashboard": "pnpm --filter @calas/web exec tsx --test --test-concurrency=1 ../../tests/dashboard-analytics.test.ts ../../tests/dashboard-export.test.ts && node scripts/dashboard-ui-check.mjs",
    "test:outreach-management": "pnpm --filter @calas/web exec tsx --test --test-concurrency=1 ../../tests/outreach-management.test.ts ../../tests/outreach-management-mcp.test.ts ../../tests/outreach-schedule-ui.test.ts",
    "test:operations": "pnpm --filter @calas/web exec tsx --test ../../tests/operations-status.test.ts",
    "check:operations-ui": "node scripts/operations-ui-check.mjs",
    "cms:prepare": "node scripts/local-prepare.mjs",
    "cms:check": "pnpm --filter @calas/web exec tsx ../../scripts/cms-check.ts",
    "content:seed": "node scripts/content-seed.mjs",
    "content:export": "node scripts/content-export.mjs",
    "content:import": "node scripts/content-import.mjs",
    "test:domain": "pnpm --filter @calas/web exec tsx --test ../../tests/content-models.test.ts ../../tests/media.test.ts",
    "test:integration": "pnpm --filter @calas/web exec tsx --test ../../tests/content-database.test.ts ../../tests/media-db.test.ts ../../tests/contact-database.test.ts ../../tests/content-backup.test.ts ../../tests/daily-backup.test.ts ../../tests/cloud-backup.test.ts",
    "db:generate": "pnpm --filter @calas/web exec drizzle-kit generate --config=../../drizzle.config.ts",
    "db:migrate": "pnpm --filter @calas/web exec tsx ../../scripts/database-migrate.ts",
    "auth:bootstrap": "pnpm --filter @calas/web exec tsx ../../scripts/auth-bootstrap.ts",
    "test:auth": "node scripts/auth-security-check.mjs",
    "test:editorial": "node scripts/pdf-editorial-e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "lighthouse": "13.5.0",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
